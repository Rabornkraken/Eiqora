# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# PDF broadcast schedule (default: 10 PM SGT, Mon-Fri)
SUMMARY_HOUR=22
SUMMARY_MINUTE=0
SUMMARY_TIMEZONE=Asia/Singapore

# PDF directory and file pattern (default: same directory as bot.py)
PDF_DIR=
PDF_PATTERN=*.pdf

# Rate limit for broadcasts (messages per second)
BROADCAST_RATE_LIMIT=25

# Allowed Telegram usernames (comma-separated, without @)
# Leave empty to allow anyone
ALLOWED_USERNAMES=user1,user2,user3
